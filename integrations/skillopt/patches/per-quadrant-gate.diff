+        # How the (hard, soft) fed to the gate are aggregated across task types.
+        #   micro (default, stock): pooled per-item average over all items.
+        #   min: the WORST task-type's (hard, soft) — so a candidate that
+        #        sacrifices one case_type to boost another cannot be accepted
+        #        (the gate score is monotonic in the weakest quadrant).
+        gate_aggregation = str(cfg.get("gate_aggregation", "micro")).strip().lower()
+        if gate_aggregation not in {"micro", "min"}:
+            raise ValueError(
+                f"evaluation.gate_aggregation must be 'micro' | 'min', "
+                f"got {gate_aggregation!r}"
+            )
+        gate_task_types = adapter.get_task_types() if gate_aggregation == "min" else []
+
+        def _gate_scores(results: list[dict]) -> tuple[float, float]:
+            """(hard, soft) the gate compares on, per ``gate_aggregation``."""
+            if gate_aggregation == "micro" or not gate_task_types:
+                return compute_score(results)
+            worst: tuple[float, float, float] | None = None
+            for tt in gate_task_types:
+                group = [r for r in results if r.get("task_type") == tt]
+                if not group:
+                    continue
+                h, s = compute_score(group)
+                score = select_gate_score(h, s, gate_metric, gate_mixed_weight)
+                if worst is None or score < worst[0]:
+                    worst = (score, h, s)
+            return (worst[1], worst[2]) if worst is not None else compute_score(results)
+
